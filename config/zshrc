# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Manjaro baseline: setopt, completion, history, keybindings and zsh plugins.
USE_POWERLINE="true"
HAS_WIDECHARS="false"
[[ -e /usr/share/zsh/manjaro-zsh-config ]] && source /usr/share/zsh/manjaro-zsh-config
[[ -e /usr/share/zsh/manjaro-zsh-prompt ]] && source /usr/share/zsh/manjaro-zsh-prompt

# The system p10k config defines POWERLEVEL9K_* itself, so p10k won't load
# ~/.p10k.zsh automatically. Source it explicitly.
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh

# Aliases
alias cls='clear'
alias cat='bat'
alias ff='fastfetch'
alias light="~/.local/bin/switch-theme.sh light"
alias dark="~/.local/bin/switch-theme.sh dark"
alias tn="tmux new-session -s"
alias tl="tmux list-sessions"
alias ta="tmux attach-session"

# NVM: full initialization costs ~0.6s; nvm stays available on demand and
# node/npm stay on PATH via the installed versions.
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh" --no-use
[[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
path+=("$HOME"/.nvm/versions/node/*/bin(N))

# Dotfiles helper functions (ordinary repo in ~/.config)
[[ -f "$HOME/.config/dotfiles/helpers.sh" ]] && source "$HOME/.config/dotfiles/helpers.sh"
