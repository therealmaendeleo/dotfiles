# Runtime/generated state
hypr/current_theme_mode
hypr/current_wallpaper.jpg
alacritty/alacritty-auto-theme/theme.toml
gtk-3.0/settings.ini
*.log

# Generated by systemctl enable
systemd/user/default.target.wants/

# Local application state: never versioned
Code/
micro/backups/
firefox/profiles/
firefox/storage/

# Alacritty themes: keep only the two Everforest files actually used
alacritty/themes/*
!alacritty/themes/LICENSE
!alacritty/themes/themes/
alacritty/themes/themes/*
!alacritty/themes/themes/everforest_dark_soft.toml
!alacritty/themes/themes/everforest_light_soft.toml

# Rofi: keep only the launcher actually used by Hyprland keybindings
rofi/images/
rofi/applets/
rofi/powermenu/
rofi/scripts/
rofi/colors/*
!rofi/colors/onedark.rasi
!rofi/colors/everforest.rasi
!rofi/colors/everforest_light_soft.rasi
!rofi/colors/gruvbox.rasi
rofi/launchers/*
!rofi/launchers/type-1/
rofi/launchers/type-1/*
!rofi/launchers/type-1/style-3.rasi
!rofi/launchers/type-1/theme-light.rasi
!rofi/launchers/type-1/theme-dark.rasi
!rofi/launchers/type-1/shared/
rofi/launchers/type-1/shared/*
!rofi/launchers/type-1/shared/colors.rasi
!rofi/launchers/type-1/shared/fonts.rasi
