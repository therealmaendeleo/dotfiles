# Bare dotfiles repository internals
.cfg/

# Runtime/generated state
.config/hypr/current_theme_mode
.config/hypr/current_wallpaper.jpg
.config/alacritty/alacritty-auto-theme/theme.toml
.config/gtk-3.0/settings.ini
.vim/.netrwhist
*.log

# Histories and transient data
.bash_history
.zsh_history
.zhistory
.viminfo
.python_history
.psql_history
.wget-hsts
.cache/
.local/share/
.config/Code/
.config/micro/backups/
.nvm/
.npm/
.cargo/

# Plugins and external assets: install separately, do not mirror here
.vim/plugged/
.config/tmux/plugins/
.config/tmux/tmux.conf.save
.local/bin/toggle-vpn.sh
.local/bin/md5
.config/waybar/
.themes/
.local/bin/emeraldian
.local/bin/claude
.local/bin/lyriq
.local/bin/poetry
.local/bin/zed

# Alacritty themes: keep only the two Everforest files actually used
.config/alacritty/themes/*
!.config/alacritty/themes/LICENSE
!.config/alacritty/themes/themes/
.config/alacritty/themes/themes/*
!.config/alacritty/themes/themes/everforest_dark_soft.toml
!.config/alacritty/themes/themes/everforest_light_soft.toml

# Rofi: keep only the launcher actually used by Hyprland keybindings
.config/rofi/images/
.config/rofi/applets/
.config/rofi/powermenu/
.config/rofi/scripts/
.config/rofi/colors/*
!.config/rofi/colors/onedark.rasi
!.config/rofi/colors/everforest.rasi
!.config/rofi/colors/everforest_light_soft.rasi
!.config/rofi/colors/gruvbox.rasi
.config/rofi/launchers/*
!.config/rofi/launchers/type-1/
.config/rofi/launchers/type-1/*
!.config/rofi/launchers/type-1/style-3.rasi
!.config/rofi/launchers/type-1/theme-light.rasi
!.config/rofi/launchers/type-1/theme-dark.rasi
!.config/rofi/launchers/type-1/shared/
.config/rofi/launchers/type-1/shared/*
!.config/rofi/launchers/type-1/shared/colors.rasi
!.config/rofi/launchers/type-1/shared/fonts.rasi

# Generated by systemctl enable
.config/systemd/user/default.target.wants/

# Firefox profiles: only prefs.js/user.js are tracked explicitly
.mozilla/firefox/*/*
!.mozilla/firefox/*/prefs.js
!.mozilla/firefox/*/user.js
