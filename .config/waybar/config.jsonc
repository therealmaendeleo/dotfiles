{
    "layer": "top",
    "position": "top",
    "height": 33,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 2,

    "modules-left": [
        "hyprland/workspaces",
        "group/media"
    ],
    "modules-center": [
	"backlight",
	"hyprland/language",
	"clock",
	"cpu",
	"memory"
    ],
    "modules-right": [
	"custom/vpn",
	"network",
	"pulseaudio",
	"pulseaudio#microphone",
        "battery",
	"custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "active-only": false,
        "format": "{name}",
        "on-click": "activate",
	"show-special": false,
	"persistent-workspaces": {}
    },

    "backlight": {
        "device": "amdgpu_bl0",
        "format": "<span size='150%'>{icon}</span>&#8201;{percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl set 1%+",
        "on-scroll-down": "brightnessctl set 1%-"
    },

    "hyprland/language": {
        "format": "<span size='130%'>󰌌</span>&#8201;{}",
        "format-en": "US",
        "format-ru": "RU"
    },

    "cpu": {
        "interval": 2,
        "format": "<span size='130%'></span>&#8201;{usage}%",
        "tooltip": true
    },

    "memory": {
        "interval": 3,
        "format": "<span size='130%'>󰻠</span>&#8201;{percentage}%",
        "tooltip-format": "ОЗУ: {used:0.1f}GiB / {total:0.1f}GiB"
    },    

    "network": {
        "format-wifi": "<span size='130%'>󰤨</span>&#8201;{essid}",
        "format-ethernet": "<span size='130%'>󰈀</span> {ipaddr}",
        "format-disconnected": "<span size='130%'>󰤭</span> Отключено",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nСигнал: {signaldBm}dBm ({signalStrength}%)"
    },

    "pulseaudio": {
        "format": "<span size='130%'>{icon}</span>&#8201;{volume}%",
        "format-muted": "<span size='130%'>󰝟</span> 0%",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
	"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "scroll-step": 5,
	"smooth-scrolling-threshold": 2
    },

    "pulseaudio#microphone": {
        "format": "{format_source}",
        "format-source": "<span size='130%'>󰍬</span>&#8201;{volume}%",
        "format-source-muted": "<span size='130%'>󰍭</span> Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
	"on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SOURCE@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
        "scroll-step": 5,
	"smooth-scrolling-threshold": 2
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "<span size='130%'>{icon}</span>&#8201;{capacity}%",
        "format-charging": "<span size='130%'>󰂄</span> {capacity}%",
        "format-plugged": "<span size='130%'>󰂄</span> {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    "custom/power": {
        "format": "<span size='130%'>󰐥</span>",
        "tooltip": "Выключить ПК",
        "on-click": "systemctl poweroff"
    },

    "custom/vpn": {
        "format": "{}",
        "exec": "nmcli connection show --active | grep -q wg0 && echo '<span size=\"130%\">󰖂</span>&#8201;ON' || echo '<span size=\"130%\">󰖂</span>&#8201;OFF'",
        "interval": 3,
        "on-click": "nmcli connection show --active | grep -q wg0 && nmcli connection down wg0 || nmcli connection up wg0",
        "tooltip": false
    }
}

