# Everforest Dark Soft — limited palette, rounded widgets
# Colors: bg #333c43, fg #d3c6aa, muted #4d5960 (all from the Vim/Alacritty theme)
set -g status-style "bg=#333c43,fg=#d3c6aa"
set -g status-bg "#333c43"
set -g status-fg "#d3c6aa"
set -g status-left "#[fg=#4d5960,bg=#333c43]#[fg=#d3c6aa,bg=#4d5960]#{s|/home/maendeleo|~|:pane_current_path} #[fg=#4d5960,bg=#333c43]"
set -g status-right "#[fg=#4d5960,bg=#333c43]#[fg=#d3c6aa,bg=#4d5960]%d.%m %H:%M #[fg=#4d5960,bg=#333c43]"
set -g status-justify left
set -g status-left-length 45
set -g status-right-length 28

set -g window-status-style "fg=#d3c6aa,bg=#333c43"
set -g window-status-format " #{?#{==:#{pane_current_command},vim},#{T;=/28:pane_title},#I:#W} "
set -g window-status-current-style "fg=#333c43,bg=#d3c6aa,bold"
set -g window-status-current-format "#[fg=#333c43,bg=#d3c6aa,bold] #{?#{==:#{pane_current_command},vim},#{T;=/28:pane_title},#I:#W} "
set -g window-status-last-style "fg=#d3c6aa,bg=#333c43,bold"
set -g window-status-activity-style "fg=#dbbc7f,bg=#333c43"
set -g window-status-bell-style "fg=#e67e80,bg=#333c43"
set -g window-status-separator ""

set -g pane-border-style "fg=#4d5960"
set -g pane-active-border-style "fg=#d3c6aa"
set -g message-style "fg=#333c43,bg=#d3c6aa"
set -g mode-style "fg=#333c43,bg=#d3c6aa"
set -g display-panes-colour "#4d5960"
set -g display-panes-active-colour "#d3c6aa"
set -g clock-mode-colour "#d3c6aa"
